# Copy to .env.local and fill in. Never commit the real file (.env* is gitignored).

# --- Supabase (browser-safe, prefixed NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the publishable key; ANON_KEY is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Python RAG backend ---
# Server-side only: deliberately NOT prefixed with NEXT_PUBLIC_. The onboarding
# API routes call this from route handlers, so the backend URL and any provider
# token stay off the browser.
BACKEND_BASE_URL=http://127.0.0.1:8000

# --- Optional ---
# Used as the post-sign-in redirect target in local dev.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
