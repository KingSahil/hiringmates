# Copy to .env and fill in. Never commit the .env file itself.

# GitHub personal access token.
#
# Optional, but strongly recommended. Anonymous access is capped at 60 requests
# per hour, which is roughly ONE profile per hour — the LOC pass costs about one
# request per repository. A token raises the ceiling to 5,000 requests per hour.
#
# Classic token:  no scopes required for public data.
# Fine-grained:   "Public Repositories (read-only)" is sufficient.
GITHUB_TOKEN=
