# Copy to backend/.env and fill in. Never commit the .env file itself.

# --- LLM (required) ---
GEMINI_API_KEY=
# gemini-3.7-flash is the locked choice; 3.8 is newer.
GEMINI_MODEL=gemini-3.7-flash

# --- Supabase, SERVICE ROLE (required for persistence) ---
# This key bypasses RLS. Never expose it to the browser, and do not prefix it
# with NEXT_PUBLIC_. Tenant isolation must be enforced in the service layer too.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cache ---
# Gates RE-EXTRACTION only. Enhanced profiles persist beyond this window.
EXTRACTION_TTL_DAYS=30
