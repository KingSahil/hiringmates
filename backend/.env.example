# Copy to backend/.env and fill in. Never commit the .env file itself.

# --- LLM provider ---------------------------------------------------------
# gemini (default) | openai | anthropic
# Only the ACTIVE provider's key is required; the others can stay blank.
LLM_PROVIDER=gemini

# --- Gemini ---------------------------------------------------------------
# gemini-3.7-flash is the locked choice; 3.8 is newer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- OpenAI-compatible ----------------------------------------------------
# Works with OpenAI and anything speaking the same wire format:
# OpenRouter, Groq, Together, Fireworks, vLLM, Ollama, LM Studio.
# Leave OPENAI_BASE_URL blank for api.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# Set to 0 for servers that reject response_format={"type":"json_object"}.
OPENAI_JSON_MODE=1

# --- Anthropic-compatible -------------------------------------------------
# Leave ANTHROPIC_BASE_URL blank for api.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=4096

# --- Supabase, SERVICE ROLE (required for persistence) ---
# This key bypasses RLS. Never expose it to the browser, and do not prefix it
# with NEXT_PUBLIC_. Tenant isolation must be enforced in the service layer too.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cache ---
# Gates RE-EXTRACTION only. Enhanced profiles persist beyond this window.
EXTRACTION_TTL_DAYS=30
